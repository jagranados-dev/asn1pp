#-------------------------------------------------
# PROJECT
#-------------------------------------------------

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"

#-------------------------------------------------
# DIRS
#-------------------------------------------------

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/doxygen
INPUT                  = @CMAKE_SOURCE_DIR@/lib
RECURSIVE              = YES
EXCLUDE                = @CMAKE_SOURCE_DIR@/build
EXCLUDE_PATTERNS       = */build/* \
                         */.git/* \
                         */third_party/* \
                         */extern/*

#-------------------------------------------------
# DOC EXTRACTION
#-------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

JAVADOC_AUTOBRIEF      = YES

#-------------------------------------------------
# C/C++ OPTIMIZATION
#-------------------------------------------------

OPTIMIZE_OUTPUT_FOR_C  = NO

#-------------------------------------------------
# HTML
#-------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html

#-------------------------------------------------
# LATEX/PDF
#-------------------------------------------------

GENERATE_LATEX         = NO

#-------------------------------------------------
# DIAGRAMS
#-------------------------------------------------

HAVE_DOT               = @DOXYGEN_HAVE_DOT@

CALL_GRAPH             = YES
CALLER_GRAPH           = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES

DOT_IMAGE_FORMAT       = svg

#-------------------------------------------------
# SOURCE FILES
#-------------------------------------------------

FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.c \
                         *.cpp

#-------------------------------------------------
# WARNINGS
#-------------------------------------------------

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES

#-------------------------------------------------
# PERFORMANCE
#-------------------------------------------------

QUIET                  = YES
